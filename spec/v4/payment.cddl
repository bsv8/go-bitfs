; 005 always carries an unsigned three-output state and a detached Buyer signature.
cumulative-payment-update = [4, refund-template-txid, payment-authorization-hash, unsigned-state-tx, buyer-signature]
refund-template-txid = bstr .size 32
payment-authorization-hash = bstr .size 32
unsigned-state-tx = bstr
buyer-signature = bstr
