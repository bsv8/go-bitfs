; Current go-bitfs pool workflow v4, bound to MultisigPool v4.
; RefundTx is the single source of truth for the refund template transaction ID (canonical TxID of the unsigned template), funding txid,
; fixed output index 0, and pool amount. The pool lock is derived from the
; ordered participant keys. None of those derived values is encoded in
; opening-proof.
;
; This v4 was hard-switched before launch: only the structures below are
; accepted, pre-switch v4 payloads and local state are rejected.
refund-template-txid = bstr .size 32
pool-refund-presign-request = [4, refund-tx, buyer-pubkey, seller-pubkey, arbiter-pubkey, fee-rate, buyer-signature]
refund-presign-response = [4, 13, refund-template-txid, seller-refund-signature]
funding-tx-delivery = [4, 14, refund-template-txid, funding-tx]
opening-proof = [4, refund-tx, buyer-pubkey, seller-pubkey, arbiter-pubkey, fee-rate, buyer-signature, seller-signature, funding-tx]
refund-tx = bstr
funding-tx = bstr
buyer-pubkey = bstr
seller-pubkey = bstr
arbiter-pubkey = bstr
fee-rate = uint
buyer-signature = bstr
seller-refund-signature = bstr
seller-signature = bstr
