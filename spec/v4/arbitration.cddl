; v4 Kind 8/9: Seller-signed custody evidence, paid arbitration receipt, and
; independent payment rebuild. Kind 8 is unchanged by the 007 fee hard switch;
; Kind 9 is a four-element receipt response carrying a positive arbiter amount.
arbitration-request = [4, 8, arbitration-claim-cbor, seller-claim-signature, content-payloads-cbor]
arbitration-claim-cbor = bstr .cbor arbitration-claim
arbitration-claim = [pool-output-satoshis, pool-output-locking-script, refund-template-raw, terms-cbor, buyer-signature]
pool-output-satoshis = uint
pool-output-locking-script = bstr .size 105
refund-template-raw = bstr .size (1..16384)
terms-cbor = bstr .size (1..16384)
buyer-signature = bstr .size (1..256)
seller-claim-signature = bstr .size (1..256)
; 64 payloads * (262144-byte MasterSeed block + 9-byte item head) + 9-byte
; array head = 16777801 bytes, matching bitfs.MaxContentPayloadsCBORBytes.
content-payloads-cbor = bstr .size (1..16777801) .cbor content-payloads

arbitration-response = [4, 9, arbitration-receipt-cbor, arbiter-receipt-signature]
arbitration-receipt-cbor = bstr .cbor arbitration-receipt
arbitration-receipt = [arbitration-claim-id, arbiter-amount-sat, arbiter-transaction-signature]
arbitration-claim-id = bstr .size 32
arbiter-amount-sat = uint .gt 0
arbiter-transaction-signature = bstr .size (1..256)
arbiter-receipt-signature = bstr .size (1..256)

; Claim and Receipt contain no version or kind. Seller signs [4, 8, claim-cbor];
; the Claim ID is SHA-256 of that exact signing domain. The Arbiter first
; rebuilds the candidate from the Claim source context, refund template, Buyer
; terms, and its own explicitly decided positive fee, signs that candidate with
; SIGHASH_FORKID|SIGHASH_ALL (binding input, sequence, locktime, all three
; output scripts, and all three output amounts), then signs
; [4, 9, receipt-cbor] as an ordinary message signature binding the exact
; Claim ID, fee, and transaction signature bytes together. The Seller recovers
; the Arbiter key from the role-ordered pool script and rebuilds the identical
; candidate locally; no raw transaction, payload hash, or unsigned tx hash
; travels on the wire. Legacy five-element Kind 9 responses are rejected
; outright; there is no dual-shape decoding in this protocol version.
