; BitFS v2 seller arbitration signature credentials (007).
; The two nested bstr values are exact deterministic CBOR child documents.

arbitration-request = [
  2,
  bstr,               ; pool-opening-proof-cbor
  bstr,               ; payment-authorization-cbor
  bstr,               ; unsigned-state-tx-raw
  bstr                ; server-transaction-signature
]

arbitration-response = [
  2,
  id,                 ; sha256(payment-authorization-cbor)
  id,                 ; sha256(unsigned-state-tx-raw)
  bstr                ; B transaction signature
]

id = bstr .size 32
