{
  "name": "go-bitfs-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Source-driven multilingual documentation for go-bitfs",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate:api": "node scripts/generate-api.mjs",
    "build": "npm run clean && npm run generate:api && docusaurus build",
    "start": "npm run generate:api && docusaurus start",
    "serve": "docusaurus serve",
    "write-translations": "npm run generate:api && docusaurus write-translations --locale zh-CN",
    "check": "npm run build"
  },
  "dependencies": {
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.0",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2"
  },
  "engines": {"node": ">=22.0.0", "npm": ">=10.0.0"}
}
