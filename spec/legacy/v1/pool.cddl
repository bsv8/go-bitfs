; BitFS pool family deterministic CBOR schema, major version 2.
; The directory name is retained for repository compatibility; version 1 is
; not accepted by the current decoders.

id = bstr .size 32

pool-refund-presign-request = [
  2, 12,
  bstr,               ; refund_tx
  id,                 ; funding_txid
  uint,               ; pool_output_index
  uint,               ; pool_output_satoshis
  bstr,               ; pool_locking_script
  pubkey,             ; server_pubkey
  pubkey,             ; buyer_pubkey
  pubkey,             ; arbiter_pubkey
  uint,               ; miner_fee_rate_sat_per_kb
  bstr                ; buyer_refund_signature
]
pool-refund-presign-response = [2, 13, bstr]
pool-funding-tx-delivery = [2, 14, bstr]

pool-opening-proof = [
  2,
  bstr,               ; refund_tx
  id,                 ; funding_txid
  uint,               ; pool_output_index
  uint,               ; pool_output_satoshis
  bstr,               ; pool_locking_script
  pubkey,             ; server_pubkey
  pubkey,             ; buyer_pubkey
  pubkey,             ; arbiter_pubkey
  uint,               ; miner_fee_rate_sat_per_kb
  bstr,               ; buyer_refund_signature
  bstr,               ; seller_refund_signature
  bstr                ; funding_tx
]

payment-update = [
  2,
  id,                 ; content_request_terms_hash
  bstr                ; partial_spend_tx
]
