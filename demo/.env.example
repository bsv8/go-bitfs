# Shared configuration for all demo commands.
# Copy this file to demo/.env. Never commit demo/.env or real private keys.

# Three role private keys, each exactly 32 bytes / 64 hex characters.
SELLER_PRIVATE_KEY_HEX=
BUYER_PRIVATE_KEY_HEX=
ARBITER_PRIVATE_KEY_HEX=

# 002 buyer funding lookup. Empty BITFS_NETWORK defaults to testnet.
BITFS_NETWORK=testnet
# Empty JUNGLEBUS_BASE_URL selects the public endpoint for BITFS_NETWORK:
# mainnet: https://junglebus.gorillapool.io
# testnet: https://testnet.junglebus.gorillapool.io
JUNGLEBUS_BASE_URL=
# Pool output amount, in satoshis.
DEMO_02_POOL_OUTPUT_SAT=20
# Miner fee rate for FundingTx and pool-opening transactions, not a
# pool/service fee. Unit: sat/KB. JungleBus does not provide a fee
# recommendation, so 0201 uses this value or its 100 sat/KB demo default.
DEMO_02_MINER_FEE_RATE_SAT_PER_KB=100

# Quote input. The seller generates the MasterSeed and file size from this file.
FILE_PATH=demo/file.bin
SEED_PRICE_SAT=4
FULL_BLOCK_PRICE_SAT=5
QUOTE_VALID_FOR=1h
# Recommended filename is derived automatically from FILE_PATH.

# Optional secure file alternative for the seller private key.
# SELLER_PRIVATE_KEY_FILE=demo/secrets/seller-private-key.value
