; v4 wire family. Quote remains independently versioned; pool/content/arbitration
; messages carry their own strict major and are not decoded as older payloads.
; This v4 was hard-switched twice before launch: first RefundTemplateTxID became
; the unified pool correlation ID, then 003/004 were switched to one payment
; sequence authorizing an ordered content-hash batch and one delivery package
; atomically carrying the same batch (see content.cddl). Only post-switch
; structures are accepted; pre-switch v4 003/004 bytes, legacy aliases, and any
; dual-shape decoding do not exist in this protocol version.
wire-family = "bitfs.protocol.v4"
